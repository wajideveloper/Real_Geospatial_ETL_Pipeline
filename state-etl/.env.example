# ============================================================================
# STATE ETL - environment configuration
#
# Copy this file to `.env` and fill in the values. The `.env` file must NOT
# be committed to version control (it contains your database password).
#
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)
#
# This example ships with a LOCAL TEST configuration (mock source data).
# Replace the WFS_* / DB_* values with the client's IRIS values for
# production. The target CRS defaults to EPSG:25832.
# ============================================================================

# ---------------------------------------------------------------------------
# WFS SOURCE (client production values go here)
# ---------------------------------------------------------------------------
# WFS endpoint + layer are empty by default: use USE_MOCK_WFS=true below for
# local testing without any client infrastructure.
WFS_URL=
WFS_LAYER=
WFS_VERSION=2.0.0
WFS_OUTPUT_FORMAT=json
WFS_ENABLE_PAGING=true
WFS_PAGE_SIZE=5000
WFS_MAX_FEATURES=0
WFS_TIMEOUT=60

# ---------------------------------------------------------------------------
# LOCAL TEST MODE (development only - remove for production)
# ---------------------------------------------------------------------------
# Reads the bundled GeoJSON fixture instead of a real WFS. This fixture is a
# synthetic test dataset, NOT the client's data.
USE_MOCK_WFS=true
MOCK_DATA_PATH=test_data/mock_state_dataset.geojson
MOCK_CRS=EPSG:4326
LOCAL_TEST_MODE=true
AUTO_CREATE_SCHEMA=true
AUTO_CREATE_TABLE=true

# ---------------------------------------------------------------------------
# POSTGRESQL / POSTGIS
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgis_35_sample
DB_USER=postgres
DB_PASSWORD=postgres42540

# ---------------------------------------------------------------------------
# TARGET TABLE
# ---------------------------------------------------------------------------
TARGET_SCHEMA=iris_core
TARGET_TABLE=state_dataset
UNIQUE_ID_FIELD=source_id
# Comma-separated fields that must NOT be overwritten by the upsert
# (e.g. created_at). Leave empty to update all attributes.
LOAD_UPDATE_EXCLUDE=

# ---------------------------------------------------------------------------
# CRS
# ---------------------------------------------------------------------------
# SOURCE_CRS is required only when the source data carries no CRS metadata.
# For the mock fixture the CRS is supplied by MOCK_CRS / the file itself.
SOURCE_CRS=
TARGET_CRS=EPSG:25832

# ---------------------------------------------------------------------------
# DATASET CONTEXT
# ---------------------------------------------------------------------------
STATE_NAME=TEST

# ---------------------------------------------------------------------------
# EXECUTION
# ---------------------------------------------------------------------------
BATCH_SIZE=1000
LOG_LEVEL=INFO

# Testing-only hook: raise a LoadError after this many committed batches to
# prove restart safety (used by tests/run_qa.py). Leave at 0 in production.
QA_FAIL_BATCH=0
